@{
    ViewData["Title"] = "RoboStore — Premium Robotics";
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>

    <div class="container">
        <div class="hero-content">
            <div class="hero-eyebrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                Next-Gen Robotics Platform
            </div>

            <h1 class="hero-title">
                <span class="gradient-text">Роботы</span><br />
                нового поколения
            </h1>

            <p class="hero-description">
                Откройте для себя передовые робототехнические решения для дома, бизнеса и развлечений.
                Премиальное качество, инновационные технологии, безупречный сервис.
            </p>

            <div class="hero-actions">
                <a href="/User/Index" class="btn btn-primary btn-xl btn-glow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                    </svg>
                    Каталог роботов
                </a>
                <a href="/Account/Register" class="btn btn-secondary btn-xl">
                    Присоединиться
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Robot Illustration -->
    <div class="hero-visual">
        <div class="hero-robot">
            <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <radialGradient id="robotGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#00D9FF" stop-opacity="0.3"/>
                        <stop offset="100%" stop-color="#00D9FF" stop-opacity="0"/>
                    </radialGradient>
                    <linearGradient id="robotBody" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#4A7FA7"/>
                        <stop offset="100%" stop-color="#00D9FF"/>
                    </linearGradient>
                </defs>
                <circle cx="100" cy="100" r="90" fill="url(#robotGlow)"/>

                <!-- Robot Head -->
                <rect x="55" y="45" width="90" height="70" rx="14" fill="url(#robotBody)"/>

                <!-- Antenna -->
                <rect x="90" y="22" width="20" height="30" rx="5" fill="#4A7FA7"/>
                <circle cx="100" cy="18" r="10" fill="#00D9FF">
                    <animate attributeName="opacity" values="1;0.4;1" dur="2s" repeatCount="indefinite"/>
                </circle>

                <!-- Eyes -->
                <circle cx="75" cy="72" r="14" fill="#0A1931"/>
                <circle cx="125" cy="72" r="14" fill="#0A1931"/>
                <circle cx="78" cy="69" r="6" fill="#00D9FF">
                    <animate attributeName="cx" values="78;82;78" dur="3s" repeatCount="indefinite"/>
                </circle>
                <circle cx="128" cy="69" r="6" fill="#00D9FF">
                    <animate attributeName="cx" values="128;124;128" dur="3s" repeatCount="indefinite"/>
                </circle>

                <!-- Mouth -->
                <rect x="70" y="90" width="60" height="10" rx="5" fill="#0A1931"/>
                <rect x="75" y="92" width="8" height="6" rx="2" fill="#00D9FF"/>
                <rect x="87" y="92" width="8" height="6" rx="2" fill="#00D9FF"/>
                <rect x="99" y="92" width="8" height="6" rx="2" fill="#00D9FF"/>
                <rect x="111" y="92" width="8" height="6" rx="2" fill="#00D9FF"/>

                <!-- Body -->
                <rect x="60" y="120" width="80" height="50" rx="10" fill="url(#robotBody)"/>
                <rect x="72" y="130" width="56" height="30" rx="6" fill="#0A1931" fill-opacity="0.4"/>

                <!-- Chest Display -->
                <rect x="82" y="135" width="36" height="20" rx="4" fill="#00D9FF" fill-opacity="0.3"/>

                <!-- Arms -->
                <rect x="38" y="125" width="18" height="14" rx="7" fill="#4A7FA7"/>
                <rect x="144" y="125" width="18" height="14" rx="7" fill="#4A7FA7"/>
                <circle cx="47" cy="132" r="5" fill="#00D9FF"/>
                <circle cx="153" cy="132" r="5" fill="#00D9FF"/>

                <!-- Legs -->
                <rect x="70" y="165" width="16" height="25" rx="6" fill="#4A7FA7"/>
                <rect x="114" y="165" width="16" height="25" rx="6" fill="#4A7FA7"/>
            </svg>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow">Категории</span>
            <h2 class="section-title">Выберите своего робота</h2>
            <p class="section-description">Широкий ассортимент роботов для любых задач</p>
        </div>

        <div class="grid grid-4">
            <a href="/User/Index?category=home" class="category-card reveal">
                <div class="category-icon">🏠</div>
                <div class="category-name">Для дома</div>
                <div class="category-count">Умные помощники</div>
            </a>

            <a href="/User/Index?category=business" class="category-card reveal">
                <div class="category-icon">🏢</div>
                <div class="category-name">Для бизнеса</div>
                <div class="category-count">Автоматизация</div>
            </a>

            <a href="/User/Index?category=entertainment" class="category-card reveal">
                <div class="category-icon">🎮</div>
                <div class="category-name">Развлечения</div>
                <div class="category-count">Игры и обучение</div>
            </a>

            <a href="/User/Index?category=industrial" class="category-card reveal">
                <div class="category-icon">🏭</div>
                <div class="category-name">Промышленные</div>
                <div class="category-count">Производство</div>
            </a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section" style="background: linear-gradient(180deg, transparent, rgba(0, 217, 255, 0.02), transparent);">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow">Преимущества</span>
            <h2 class="section-title">Почему RoboStore?</h2>
            <p class="section-description">Платформа нового поколения для покупки и управления роботами</p>
        </div>

        <div class="grid grid-4">
            <div class="feature-card reveal">
                <div class="feature-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <h3 class="feature-title">Роботы</h3>
                <p class="feature-description">Широкий ассортимент роботов для дома, офиса и промышленности</p>
            </div>

            <div class="feature-card reveal">
                <div class="feature-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="9" cy="21" r="1"/>
                        <circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
                    </svg>
                </div>
                <h3 class="feature-title">Каталог</h3>
                <p class="feature-description">Удобный поиск и фильтрация по типу, характеристикам и цене</p>
            </div>

            <div class="feature-card reveal">
                <div class="feature-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <h3 class="feature-title">Заказы</h3>
                <p class="feature-description">Быстрое оформление, отслеживание статуса и история покупок</p>
            </div>

            <div class="feature-card reveal">
                <div class="feature-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3 class="feature-title">Гарантия</h3>
                <p class="feature-description">Официальная гарантия и сервисное обслуживание на все роботы</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="cta-card">
            <div class="cta-glow"></div>
            <h2 class="cta-title">Готовы начать?</h2>
            <p class="cta-description">Создайте аккаунт и откройте мир робототехники</p>
            <div class="cta-actions">
                <a href="/Account/Register" class="btn btn-primary btn-xl btn-glow">
                    Регистрация
                </a>
                <a href="/Account/Login" class="btn btn-ghost btn-xl">
                    Войти
                </a>
            </div>
        </div>
    </div>
</section>
