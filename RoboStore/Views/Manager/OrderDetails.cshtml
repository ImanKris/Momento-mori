@model RoboStore.Models.Order

@{
    ViewData["Title"] = $"Заказ #{Model.Id}";
}

<h1 class="mb-4">Заказ #@Model.Id</h1>

<div class="card">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Информация о заказе</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">ID заказа:</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Дата заказа:</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Текущий статус:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @GetStatusBadgeClass(Model.Status) fs-6" id="status-badge">@Model.Status</span>
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Клиент:</dt>
                    <dd class="col-sm-8">@Model.User?.Login</dd>
                </dl>
            </div>
        </div>

        <hr>

        <h5>Заказанный робот</h5>
        <div class="row">
            <div class="col-md-12">
                <dl class="row">
                    <dt class="col-sm-2">Модель:</dt>
                    <dd class="col-sm-4">@Model.Robot?.Model</dd>

                    <dt class="col-sm-2">Тип:</dt>
                    <dd class="col-sm-4">@Model.Robot?.Type</dd>

                    <dt class="col-sm-2">Цена:</dt>
                    <dd class="col-sm-4">@Model.Robot?.Price.ToString("N0") руб.</dd>
                </dl>
            </div>
        </div>

        <hr>

        <h5>Изменить статус</h5>
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-warning @(Model.Status == "В обработке" ? "active" : "")"
                    onclick="updateStatus(@Model.Id, 'В обработке')">
                В обработке
            </button>
            <button type="button" class="btn btn-outline-info @(Model.Status == "Отправлен" ? "active" : "")"
                    onclick="updateStatus(@Model.Id, 'Отправлен')">
                Отправлен
            </button>
            <button type="button" class="btn btn-outline-success @(Model.Status == "Выполнен" ? "active" : "")"
                    onclick="updateStatus(@Model.Id, 'Выполнен')">
                Выполнен
            </button>
            <button type="button" class="btn btn-outline-danger @(Model.Status == "Отменён" ? "active" : "")"
                    onclick="updateStatus(@Model.Id, 'Отменён')">
                Отменён
            </button>
        </div>

        <div class="mt-3">
            <a asp-action="Orders" class="btn btn-secondary">Назад к списку</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function updateStatus(orderId, newStatus) {
            try {
                const response = await fetch('@Url.Action("UpdateStatus", "Manager")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ orderId: orderId, status: newStatus })
                });

                const data = await response.json();

                if (data.success) {
                    const badge = document.getElementById('status-badge');
                    if (badge) {
                        badge.textContent = newStatus;
                        badge.className = 'badge ' + getBadgeClass(newStatus) + ' fs-6';
                    }
                } else {
                    alert(data.message || 'Ошибка при обновлении статуса');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Произошла ошибка при обновлении статуса');
            }
        }

        function getBadgeClass(status) {
            switch (status) {
                case 'Выполнен': return 'bg-success';
                case 'В обработке': return 'bg-warning text-dark';
                case 'Отправлен': return 'bg-info';
                case 'Доставлен': return 'bg-success';
                case 'Отменён': return 'bg-danger';
                default: return 'bg-secondary';
            }
        }
    </script>
}

@{
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Выполнен" => "bg-success",
            "В обработке" => "bg-warning text-dark",
            "Отправлен" => "bg-info",
            "Доставлен" => "bg-success",
            "Отменён" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
