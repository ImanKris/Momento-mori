@model List<RoboStore.Models.Order>

@{
    ViewData["Title"] = "Все заказы";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-4">
        <div class="admin-header-icon" style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: rgba(0, 217, 255, 0.1); border-radius: 16px; color: var(--accent-primary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
        </div>
        <div>
            <h1 class="page-title">Все заказы</h1>
            <p class="page-subtitle">Управление заказами клиентов</p>
        </div>
    </div>
</div>

<div class="admin-table-card">
    <div class="admin-table-header">
        <div class="admin-table-title">Заказы (@(Model?.Count ?? 0))</div>
        <div class="d-flex gap-3">
            <select class="status-select" onchange="filterByStatus(this.value)">
                <option value="">Все статусы</option>
                <option value="В обработке">В обработке</option>
                <option value="Отправлен">Отправлен</option>
                <option value="Выполнен">Выполнен</option>
                <option value="Отменён">Отменён</option>
            </select>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Дата</th>
                        <th>Клиент</th>
                        <th>Робот</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody">
                    @foreach (var order in Model)
                    {
                        var statusClass = order.Status switch
                        {
                            "Выполнен" => "success",
                            "В обработке" => "warning",
                            "Отправлен" => "primary",
                            "Отменён" => "error",
                            _ => "info"
                        };
                        <tr data-status="@order.Status">
                            <td style="font-weight: 700; color: var(--text-primary);">#@order.Id</td>
                            <td style="color: var(--text-muted); font-size: 13px;">@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 28px; height: 28px; background: var(--accent-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: var(--bg-primary);">@order.User?.Login[0]</div>
                                    <span>@order.User?.Login</span>
                                </div>
                            </td>
                            <td>@order.Robot?.Model</td>
                            <td style="font-family: 'Montserrat', sans-serif; font-weight: 700;">@(order.Robot?.Price.ToString("N0") ?? "—") ₽</td>
                            <td>
                                <span class="badge badge-@statusClass" id="status-@order.Id">@order.Status</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-ghost btn-sm" title="Подробнее">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <line x1="12" y1="16" x2="12" y2="12"/>
                                            <line x1="12" y1="8" x2="12.01" y2="8"/>
                                        </svg>
                                    </a>
                                    <select class="status-select" onchange="updateStatus(@order.Id, this.value)" style="min-width: 120px;">
                                        <option value="В обработке" selected="@(order.Status == "В обработке" ? "selected" : null)">В обработке</option>
                                        <option value="Отправлен" selected="@(order.Status == "Отправлен" ? "selected" : null)">Отправлен</option>
                                        <option value="Выполнен" selected="@(order.Status == "Выполнен" ? "selected" : null)">Выполнен</option>
                                        <option value="Отменён" selected="@(order.Status == "Отменён" ? "selected" : null)">Отменён</option>
                                    </select>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 01-8 0"/>
                </svg>
            </div>
            <h3 class="empty-state-title">Заказов пока нет</h3>
        </div>
    }
</div>

@section Scripts {
<script>
async function updateStatus(orderId, newStatus) {
    try {
        const response = await fetch('@Url.Action("UpdateStatus", "Manager")', {
            method: 'POST',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ orderId: orderId, status: newStatus })
        });

        const data = await response.json();

        if (data.success) {
            const badge = document.getElementById('status-' + orderId);
            if (badge) {
                badge.textContent = newStatus;
                badge.className = 'badge badge-' + getStatusClass(newStatus);
            }
            showToast('Статус обновлен', 'success');
        } else {
            showToast(data.message || 'Ошибка при обновлении статуса', 'error');
        }
    } catch (error) {
        console.error('Error:', error);
        showToast('Ошибка при обновлении статуса', 'error');
    }
}

function getStatusClass(status) {
    switch (status) {
        case 'Выполнен': return 'success';
        case 'В обработке': return 'warning';
        case 'Отправлен': return 'primary';
        case 'Отменён': return 'error';
        default: return 'info';
    }
}

function filterByStatus(status) {
    const rows = document.querySelectorAll('#ordersTableBody tr');
    rows.forEach(row => {
        if (!status || row.dataset.status === status) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>
}
