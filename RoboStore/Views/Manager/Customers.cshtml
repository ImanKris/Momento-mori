@model List<RoboStore.Models.User>

@{
    ViewData["Title"] = "Клиенты";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-4">
        <div class="admin-header-icon" style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: rgba(0, 217, 255, 0.1); border-radius: 16px; color: var(--accent-primary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                <path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
        </div>
        <div>
            <h1 class="page-title">Клиенты</h1>
            <p class="page-subtitle">Список зарегистрированных пользователей</p>
        </div>
    </div>
</div>

<div class="admin-table-card">
    <div class="admin-table-header">
        <div class="admin-table-title">Пользователи (@(Model?.Count ?? 0))</div>
        <div class="admin-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" placeholder="Поиск по логину..." onkeyup="searchUsers(this.value)" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Пользователь</th>
                        <th>Дата регистрации</th>
                        <th>Заказов</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @foreach (var user in Model)
                    {
                        <tr data-login="@user.Login.ToLower()">
                            <td style="font-family: monospace; color: var(--text-muted); font-size: 13px;">#@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; color: var(--bg-primary);">@user.Login[0]</div>
                                    <div class="d-flex flex-column">
                                        <span style="font-weight: 600; color: var(--text-primary);">@user.Login</span>
                                        <span style="font-size: 12px; color: var(--text-muted);">
                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge badge-error" style="font-size: 10px;">Админ</span>
                                            }
                                            else if (user.Role == "Manager")
                                            {
                                                <span class="badge badge-warning" style="font-size: 10px;">Менеджер</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-primary" style="font-size: 10px;">Клиент</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td style="color: var(--text-muted);">@user.CreatedAt.ToString("dd MMMM yyyy")</td>
                            <td>
                                <a asp-controller="Manager" asp-action="Orders" asp-route-userId="@user.Id" class="btn btn-ghost btn-sm">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                                        <line x1="3" y1="6" x2="21" y2="6"/>
                                        <path d="M16 10a4 4 0 01-8 0"/>
                                    </svg>
                                    Заказы
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                </svg>
            </div>
            <h3 class="empty-state-title">Клиентов пока нет</h3>
        </div>
    }
</div>

<script>
function searchUsers(query) {
    const rows = document.querySelectorAll('#usersTableBody tr');
    const q = query.toLowerCase();
    rows.forEach(row => {
        if (row.dataset.login.includes(q)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>
