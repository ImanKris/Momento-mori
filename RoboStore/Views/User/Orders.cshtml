@model List<RoboStore.Models.Order>

@{
    ViewData["Title"] = "Мои заказы";
}

<div class="page-header">
    <h1 class="page-title">Мои заказы</h1>
    <p class="page-subtitle">История покупок и текущие заказы</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Message"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="orders-list">
        @foreach (var order in Model)
        {
            var statusClass = order.Status switch
            {
                "Выполнен" => "success",
                "В обработке" => "warning",
                "Отправлен" => "primary",
                "Доставлен" => "success",
                "Отменён" => "error",
                _ => "info"
            };

            var statusIcon = order.Status switch
            {
                "Выполнен" => "check-circle",
                "В обработке" => "clock",
                "Отправлен" => "truck",
                "Доставлен" => "package",
                "Отменён" => "x-circle",
                _ => "circle"
            };

            <div class="order-card">
                <div class="order-card-header">
                    <div class="order-info">
                        <span class="order-number">Заказ #@order.Id</span>
                        <span class="order-date">@order.OrderDate.ToString("dd MMMM yyyy, HH:mm")</span>
                    </div>
                    <div class="badge badge-@statusClass" style="display: inline-flex; gap: 6px; padding: 8px 16px;">
                        @if (statusIcon == "check-circle")
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        }
                        else if (statusIcon == "clock")
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                        }
                        else if (statusIcon == "truck")
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="1" y="3" width="15" height="13"/>
                                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>
                        }
                        else if (statusIcon == "package")
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                        }
                        else if (statusIcon == "x-circle")
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        }
                        @order.Status
                    </div>
                </div>

                <div class="order-card-body">
                    @if (order.Robot != null)
                    {
                        <div class="order-product">
                            <div class="order-product-image">
                                <span style="font-size: 36px;">🤖</span>
                            </div>
                            <div class="order-product-info">
                                <h3 class="order-product-name">@order.Robot.Model</h3>
                                <p class="order-product-type">@order.Robot.Type</p>
                            </div>
                            <div class="order-product-price">
                                @order.Robot.Price.ToString("N0") ₽
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="order-product">
                            <div class="order-product-image">
                                <span style="font-size: 36px;">📦</span>
                            </div>
                            <div class="order-product-info">
                                <p class="order-product-name">Информация о товаре недоступна</p>
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
            </svg>
        </div>
        <h3 class="empty-state-title">У вас пока нет заказов</h3>
        <p class="empty-state-text">Оформите первый заказ в нашем каталоге</p>
        <a href="/User/Index" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
            </svg>
            В каталог
        </a>
    </div>
}

<style>
.orders-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.order-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
}

.order-card:hover {
    border-color: var(--border-hover);
}

.order-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
}

.order-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.order-number {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
}

.order-date {
    font-size: 13px;
    color: var(--text-muted);
}

.order-card-body {
    padding: 24px;
}

.order-product {
    display: flex;
    align-items: center;
    gap: 20px;
}

.order-product-image {
    width: 80px;
    height: 80px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.order-product-info {
    flex: 1;
}

.order-product-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
}

.order-product-type {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
}

.order-product-price {
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
}

.order-shipping {
    padding-top: 16px;
    border-top: 1px solid var(--border);
}
</style>
