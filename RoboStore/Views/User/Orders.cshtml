@model List<RoboStore.Models.Order>

@{
    ViewData["Title"] = "Мои заказы";
}

<h2 class="mb-4">Мои заказы</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>№ заказа</th>
                    <th>Дата</th>
                    <th>Название робота</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.Robot?.Model</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4 class="mb-3">У вас пока нет заказов</h4>
        <a asp-action="Index" class="btn btn-primary">В каталог</a>
    </div>
}

@{
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Выполнен" => "bg-success",
            "В обработке" => "bg-warning text-dark",
            "Отправлен" => "bg-info",
            "Доставлен" => "bg-success",
            "Отменён" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
