@model List<RoboStore.Models.Robot>

@{
    ViewData["Title"] = "Оформление заказа";
}

<div class="page-header">
    <h1 class="page-title">Оформление заказа</h1>
    <p class="page-subtitle">Заполните данные для доставки и оплаты</p>
</div>

<div id="checkoutContent">
    <!-- Loading state -->
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
        </div>
        <h3 class="empty-state-title">Загрузка...</h3>
    </div>
</div>

<script>
function loadCheckout() {
    const cart = JSON.parse(localStorage.getItem('robostore_cart') || '[]');
    const container = document.getElementById('checkoutContent');

    if (cart.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">Корзина пуста</h3>
                <p class="empty-state-text">Добавьте товары перед оформлением</p>
                <a href="/User/Index" class="btn btn-primary">В каталог</a>
            </div>
        `;
        return;
    }

    const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

    let itemsHtml = cart.map(item => `
        <div class="checkout-item">
            <div class="checkout-item-image">
                <span style="font-size: 24px;">🤖</span>
            </div>
            <div class="checkout-item-info">
                <div class="checkout-item-title">${item.name}</div>
                <div class="checkout-item-qty">Кол-во: ${item.quantity}</div>
            </div>
            <div class="checkout-item-price">${(item.price * item.quantity).toLocaleString('ru-RU')} ₽</div>
        </div>
    `).join('');

    container.innerHTML = `
        <div class="checkout-layout">
            <div class="checkout-form">
                <!-- Contact Info -->
                <div class="card mb-6">
                    <div class="card-header">
                        <h3 class="card-title">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 8px;">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            Контактные данные
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="grid grid-2 gap-4">
                            <div class="form-group">
                                <label class="form-label">Имя</label>
                                <input type="text" id="customerName" class="form-control" placeholder="Иван Иванов" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Телефон</label>
                                <input type="tel" id="customerPhone" class="form-control" placeholder="+7 (999) 123-45-67" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email" id="customerEmail" class="form-control" placeholder="email@example.com" />
                        </div>
                    </div>
                </div>

                <!-- Shipping -->
                <div class="card mb-6">
                    <div class="card-header">
                        <h3 class="card-title">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 8px;">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            Адрес доставки
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Город</label>
                            <input type="text" id="city" class="form-control" placeholder="Санкт-Петербург" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Адрес</label>
                            <input type="text" id="address" class="form-control" placeholder="ул. Пушкина, д. 10, кв. 5" />
                        </div>
                    </div>
                </div>

                <!-- Payment -->
                <div class="card" id="paymentSection">
                    <div class="card-header">
                        <h3 class="card-title">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 8px;">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                                <line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                            Оплата картой
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="payment-card">
                            <div class="payment-header">
                                <div class="payment-icon">💳</div>
                                <div>
                                    <div class="payment-title">Привязка карты</div>
                                    <div class="payment-subtitle">Введите данные карты для оплаты</div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Номер карты</label>
                                <input type="text" id="cardNumber" class="form-control" placeholder="0000 0000 0000 0000"
                                       maxlength="19" oninput="formatCardNumber(this)" />
                            </div>

                            <div class="grid grid-2 gap-4">
                                <div class="form-group">
                                    <label class="form-label">Срок действия</label>
                                    <input type="text" id="cardExpiry" class="form-control" placeholder="MM/YY"
                                           maxlength="5" oninput="formatExpiry(this)" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">CVV</label>
                                    <input type="password" id="cardCvv" class="form-control" placeholder="•••"
                                           maxlength="3" />
                                </div>
                            </div>
                        </div>

                        <button type="button" onclick="processPayment()" id="payButton" class="btn btn-primary btn-xl btn-block btn-glow mt-6">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            Оплатить ${total.toLocaleString('ru-RU')} ₽
                        </button>

                        <div id="paymentResult" class="mt-4"></div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="checkout-summary">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Ваш заказ</h3>
                    </div>
                    <div class="card-body">
                        <div class="checkout-items">
                            ${itemsHtml}
                        </div>

                        <div style="border-top: 1px solid var(--border); margin-top: 16px; padding-top: 16px;">
                            <div class="summary-row">
                                <span>Подытог</span>
                                <span>${total.toLocaleString('ru-RU')} ₽</span>
                            </div>
                            <div class="summary-row">
                                <span>Доставка</span>
                                <span class="text-success">Бесплатно</span>
                            </div>
                        </div>

                        <div class="summary-total mt-4">
                            <span>Итого</span>
                            <span>${total.toLocaleString('ru-RU')} ₽</span>
                        </div>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-body">
                        <div style="display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 13px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                            <span>Безопасный платеж. Данные карты зашифрованы.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function formatCardNumber(input) {
    let value = input.value.replace(/\D/g, '');
    let formatted = '';
    for (let i = 0; i < value.length && i < 16; i++) {
        if (i > 0 && i % 4 === 0) formatted += ' ';
        formatted += value[i];
    }
    input.value = formatted;
}

function formatExpiry(input) {
    let value = input.value.replace(/\D/g, '');
    if (value.length >= 2) {
        value = value.substring(0, 2) + '/' + value.substring(2, 4);
    }
    input.value = value;
}

async function processPayment() {
    const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
    const cardExpiry = document.getElementById('cardExpiry').value;
    const cardCvv = document.getElementById('cardCvv').value;
    const resultDiv = document.getElementById('paymentResult');
    const payButton = document.getElementById('payButton');

    // Validation
    if (cardNumber.length !== 16) {
        resultDiv.innerHTML = '<div class="alert alert-error"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Введите 16-значный номер карты</div>';
        return;
    }
    if (!cardExpiry.match(/^\d{2}\/\d{2}$/)) {
        resultDiv.innerHTML = '<div class="alert alert-error"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Введите срок действия карты (MM/YY)</div>';
        return;
    }
    if (cardCvv.length !== 3) {
        resultDiv.innerHTML = '<div class="alert alert-error"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>Введите CVV (3 цифры)</div>';
        return;
    }

    // Show loading
    payButton.disabled = true;
    payButton.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Обработка...';
    resultDiv.innerHTML = '';

    // Simulate payment processing
    await new Promise(resolve => setTimeout(resolve, 2000));

    // Success!
    const cart = JSON.parse(localStorage.getItem('robostore_cart') || '[]');
    const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

    // Clear cart
    localStorage.setItem('robostore_cart', JSON.stringify([]));
    document.dispatchEvent(new Event('cartUpdated'));

    // Show success
    const paymentSection = document.getElementById('paymentSection');
    paymentSection.querySelector('.card-body').innerHTML = `
        <div class="payment-success">
            <div class="payment-success-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div class="payment-success-title">Оплата прошла!</div>
            <div class="payment-success-text">Заказ оформлен. Ожидайте звонка для подтверждения.</div>
            <a href="/User/Orders" class="btn btn-primary btn-lg mt-6">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
                </svg>
                К моим заказам
            </a>
        </div>
    `;
}

document.addEventListener('DOMContentLoaded', loadCheckout);
</script>

<style>
.spin {
    animation: spin 1s linear infinite;
}

@@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>
