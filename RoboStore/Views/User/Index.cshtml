@{
    ViewData["Title"] = "Каталог роботов";
}
@using System.Linq

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title">Каталог роботов</h1>
            <p class="page-subtitle">Выберите робота для вашего проекта</p>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Message"]
    </div>
}

<div class="catalog-layout">
    <!-- Sidebar Filters -->
    <aside class="catalog-sidebar">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="filter-section">
                <h3 class="filter-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Поиск
                </h3>
                <input type="text" class="form-control" id="search" name="search"
                       value="@ViewBag.Search" placeholder="Название робота..." />
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Тип робота</h3>
                <label class="filter-option">
                    <input type="checkbox" name="typeId" value="" @(string.IsNullOrEmpty(ViewBag.SelectedTypeId?.ToString()) ? "checked" : "") />
                    <span class="checkbox-custom"></span>
                    Все типы
                </label>
                @if (ViewBag.RobotTypes != null)
                {
                    foreach (var type in ViewBag.RobotTypes)
                    {
                        <label class="filter-option">
                            <input type="checkbox" name="typeId" value="@type.Id"
                                   @(ViewBag.SelectedTypeId?.ToString() == type.Id.ToString() ? "checked" : "") />
                            <span class="checkbox-custom"></span>
                            @type.Name
                        </label>
                    }
                }
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Наличие</h3>
                <label class="filter-option">
                    <input type="radio" name="inStock" value="" checked />
                    <span class="checkbox-custom" style="border-radius: 50%;"></span>
                    Все
                </label>
                <label class="filter-option">
                    <input type="radio" name="inStock" value="yes" @(ViewBag.InStock == "yes" ? "checked" : "") />
                    <span class="checkbox-custom" style="border-radius: 50%;"></span>
                    В наличии
                </label>
                <label class="filter-option">
                    <input type="radio" name="inStock" value="no" @(ViewBag.InStock == "no" ? "checked" : "") />
                    <span class="checkbox-custom" style="border-radius: 50%;"></span>
                    Нет в наличии
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Применить
            </button>
            <a asp-action="Index" class="btn btn-ghost btn-block mt-3">Сбросить</a>
        </form>
    </aside>

    <!-- Products Grid -->
    <div class="catalog-main">
        <div class="catalog-header">
            <div class="catalog-info">
                @if (Model != null && Model.Count > 0)
                {
                    <span>Найдено: <strong>@Model.Count</strong> роботов</span>
                }
            </div>
            <div class="catalog-toolbar">
                <select class="sort-select" onchange="sortProducts(this.value)">
                    <option value="">Сортировка</option>
                    <option value="price-asc">Цена: по возрастанию</option>
                    <option value="price-desc">Цена: по убыванию</option>
                    <option value="name">По названию</option>
                </select>
            </div>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="grid grid-3" id="productsGrid">
                @foreach (var robot in Model)
                {
                    <article class="product-card reveal" data-price="@robot.Price" data-name="@robot.Model">
                        <a asp-action="Details" asp-route-id="@robot.Id" class="product-card-link">
                            <div class="product-card-img">
                                <span style="font-size: 80px;">🤖</span>
                            </div>
                            <div class="product-card-body">
                                <div class="product-card-category">@robot.Type</div>
                                <h3 class="product-card-title">@robot.Model</h3>
                                @if (!string.IsNullOrEmpty(robot.Manufacturer))
                                {
                                    <div class="text-muted" style="font-size: 12px; margin-bottom: 4px;">@robot.Manufacturer</div>
                                }
                                @if (!string.IsNullOrEmpty(robot.Description))
                                {
                                    <p class="text-muted" style="font-size: 12px; line-height: 1.4; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@robot.Description</p>
                                }
                                <div class="product-card-price">
                                    @robot.Price.ToString("N0") ₽
                                </div>
                            </div>
                        </a>
                        <div class="product-card-footer">
                            <a asp-action="Details" asp-route-id="@robot.Id" class="btn btn-secondary btn-sm">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="16" x2="12" y2="12"/>
                                    <line x1="12" y1="8" x2="12.01" y2="8"/>
                                </svg>
                                Подробнее
                            </a>
                            @if (robot.Stock > 0)
                            {
                                <button onclick="addToCart(@robot.Id, '@robot.Model.Replace("'", "\\'")', @robot.Price)" class="btn btn-primary btn-sm">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="9" cy="21" r="1"/>
                                        <circle cx="20" cy="21" r="1"/>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
                                    </svg>
                                    В корзину
                                </button>
                            }
                            else
                            {
                                <span class="badge badge-error">Нет в наличии</span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <h3 class="empty-state-title">Роботы не найдены</h3>
                <p class="empty-state-text">Попробуйте изменить параметры фильтрации</p>
                <a asp-action="Index" class="btn btn-primary">Сбросить фильтры</a>
            </div>
        }
    </div>
</div>

<style>
.product-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
}

.product-card-link:hover {
    color: inherit;
}
</style>

<script>
function addToCart(id, name, price) {
    let cart = JSON.parse(localStorage.getItem('robostore_cart') || '[]');
    const existing = cart.find(item => item.id === id);

    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({ id, name, price, quantity: 1 });
    }

    localStorage.setItem('robostore_cart', JSON.stringify(cart));
    document.dispatchEvent(new Event('cartUpdated'));

    // Animate badge
    const badge = document.getElementById('cartBadgeHeader');
    if (badge) {
        badge.classList.remove('bounce');
        void badge.offsetWidth;
        badge.classList.add('bounce');
    }

    showToast(`${name} добавлен в корзину`, 'success');
}

function sortProducts(value) {
    const grid = document.getElementById('productsGrid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.product-card'));

    cards.sort((a, b) => {
        if (value === 'price-asc') {
            return parseInt(a.dataset.price) - parseInt(b.dataset.price);
        } else if (value === 'price-desc') {
            return parseInt(b.dataset.price) - parseInt(a.dataset.price);
        } else if (value === 'name') {
            return a.dataset.name.localeCompare(b.dataset.name, 'ru');
        }
        return 0;
    });

    cards.forEach(card => grid.appendChild(card));
}
</script>
