@model RoboStore.Models.Robot

@{
    ViewData["Title"] = Model?.Model ?? "Робот";
}

<div class="page-header">
    <a href="/User/Index" class="btn btn-ghost btn-sm mb-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
        </svg>
        Назад в каталог
    </a>
</div>

@if (Model != null)
{
    <div class="product-detail">
        <div class="product-gallery">
            <div class="product-main-image">
                <span style="font-size: 120px;">🤖</span>
            </div>
        </div>

        <div class="product-info">
            <div class="product-category">@Model.Type</div>
            <h1 class="product-title">@Model.Model</h1>

            @if (!string.IsNullOrEmpty(Model.SerialNumber))
            {
                <p class="text-muted mb-4" style="font-size: 14px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle;">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 3v4M8 3v4"/>
                    </svg>
                    Серийный номер: @Model.SerialNumber
                </p>
            }

            <div class="product-price-large">
                @Model.Price.ToString("N0") ₽
            </div>

            <div class="@(Model.Stock > 0 ? "badge badge-success" : "badge badge-error") mb-6" style="display: inline-flex; gap: 6px; padding: 8px 16px;">
                @if (Model.Stock > 0)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>В наличии: @Model.Stock шт.</span>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    <span>Нет в наличии</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="product-description">
                    <h4 style="color: var(--text-primary); margin-bottom: 12px;">Описание</h4>
                    <p>@Model.Description</p>
                </div>
            }

            <div class="product-specs">
                <h4 style="color: var(--text-primary); margin-bottom: 12px;">Характеристики</h4>
                <div class="spec-row">
                    <span class="spec-label">Тип</span>
                    <span class="spec-value">@Model.Type</span>
                </div>
                <div class="spec-row">
                    <span class="spec-label">Модель</span>
                    <span class="spec-value">@Model.Model</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Manufacturer))
                {
                    <div class="spec-row">
                        <span class="spec-label">Производитель</span>
                        <span class="spec-value">@Model.Manufacturer</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CountryOfOrigin))
                {
                    <div class="spec-row">
                        <span class="spec-label">Страна</span>
                        <span class="spec-value">@Model.CountryOfOrigin</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.SerialNumber))
                {
                    <div class="spec-row">
                        <span class="spec-label">Серийный номер</span>
                        <span class="spec-value">@Model.SerialNumber</span>
                    </div>
                }
                @if (Model.WeightKg.HasValue)
                {
                    <div class="spec-row">
                        <span class="spec-label">Вес</span>
                        <span class="spec-value">@Model.WeightKg.Value кг</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Dimensions))
                {
                    <div class="spec-row">
                        <span class="spec-label">Размеры (ШxВxГ)</span>
                        <span class="spec-value">@Model.Dimensions см</span>
                    </div>
                }
                @if (Model.BatteryLifeHours.HasValue && Model.BatteryLifeHours.Value > 0)
                {
                    <div class="spec-row">
                        <span class="spec-label">Время работы</span>
                        <span class="spec-value">@Model.BatteryLifeHours.Value ч</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.PowerSource))
                {
                    <div class="spec-row">
                        <span class="spec-label">Питание</span>
                        <span class="spec-value">@Model.PowerSource</span>
                    </div>
                }
                @if (Model.MaxSpeedKmh.HasValue && Model.MaxSpeedKmh.Value > 0)
                {
                    <div class="spec-row">
                        <span class="spec-label">Макс. скорость</span>
                        <span class="spec-value">@Model.MaxSpeedKmh.Value км/ч</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Connectivity))
                {
                    <div class="spec-row">
                        <span class="spec-label">Связь</span>
                        <span class="spec-value">@Model.Connectivity</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.OperatingSystem))
                {
                    <div class="spec-row">
                        <span class="spec-label">ОС</span>
                        <span class="spec-value">@Model.OperatingSystem</span>
                    </div>
                }
                @if (Model.WarrantyMonths.HasValue && Model.WarrantyMonths.Value > 0)
                {
                    <div class="spec-row">
                        <span class="spec-label">Гарантия</span>
                        <span class="spec-value">@Model.WarrantyMonths.Value мес.</span>
                    </div>
                }
                <div class="spec-row">
                    <span class="spec-label">На складе</span>
                    <span class="spec-value">@(Model.Stock > 0 ? $"{Model.Stock} шт." : "Нет")</span>
                </div>
            </div>

            <div class="product-actions">
                @if (Model.Stock > 0)
                {
                    <button onclick="addToCartAndRedirect(@Model.Id, '@Model.Model.Replace("'", "\\'")', @Model.Price)" class="btn btn-primary btn-xl btn-glow">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"/>
                            <circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
                        </svg>
                        Добавить в корзину
                    </button>
                }
                <a href="/User/Index" class="btn btn-secondary btn-lg">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"/>
                        <rect x="14" y="3" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/>
                    </svg>
                    В каталог
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h3 class="empty-state-title">Робот не найден</h3>
        <p class="empty-state-text">Информация о данном товаре недоступна</p>
        <a href="/User/Index" class="btn btn-primary">В каталог</a>
    </div>
}

<script>
function addToCartAndRedirect(id, name, price) {
    let cart = JSON.parse(localStorage.getItem('robostore_cart') || '[]');
    const existing = cart.find(item => item.id === id);

    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({ id, name, price, quantity: 1 });
    }

    localStorage.setItem('robostore_cart', JSON.stringify(cart));
    document.dispatchEvent(new Event('cartUpdated'));

    showToast(`${name} добавлен в корзину`, 'success');

    // Animate badge
    const badge = document.getElementById('cartBadgeHeader');
    if (badge) {
        badge.classList.remove('bounce');
        void badge.offsetWidth;
        badge.classList.add('bounce');
    }
}
</script>
