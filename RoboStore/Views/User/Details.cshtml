@model RoboStore.Models.Robot

@{
    ViewData["Title"] = Model?.Model ?? "Робот";
}

@if (Model != null)
{
    <h2 class="mb-4">@Model.Model</h2>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-center bg-light" style="min-height: 300px;">
                    <span class="display-1 text-primary">@Model.Model.FirstOrDefault()</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@Model.Model</h5>
                    <h6 class="card-subtitle mb-3 text-muted">@Model.Type</h6>

                    <table class="table table-borderless">
                        <tr>
                            <td><strong>Тип:</strong></td>
                            <td>@Model.Type</td>
                        </tr>
                        <tr>
                            <td><strong>Цена:</strong></td>
                            <td class="fs-3 text-success fw-bold">@Model.Price.ToString("N0") руб.</td>
                        </tr>
                        <tr>
                            <td><strong>На складе:</strong></td>
                            <td>
                                @(Model.Stock > 0 ? $"{Model.Stock} шт." : "Нет в наличии")
                            </td>
                        </tr>
                    </table>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-warning">@ViewBag.Message</div>
                    }

                    <div class="d-grid gap-2">
                        @if (Model.Stock > 0)
                        {
                            <a asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-lg btn-success">Добавить в корзину</a>
                        }
                        else
                        {
                            <button class="btn btn-lg btn-secondary" disabled>Нет в наличии</button>
                        }
                        <a asp-action="Index" class="btn btn-lg btn-outline-secondary">Назад к каталогу</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <h4>Робот не найден</h4>
        <a asp-action="Index" class="btn btn-primary">В каталог</a>
    </div>
}
