<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RoboStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="User" asp-action="Index">RoboStore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Index">Каталог</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Cart">Корзина</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="Orders">Мои заказы</a>
                    </li>

                    @if (User.IsInRole("Manager"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning" href="#" id="managerDropdown" role="button" data-bs-toggle="dropdown">
                                Панель менеджера
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Manager" asp-action="Index">Дашборд</a></li>
                                <li><a class="dropdown-item" asp-controller="Manager" asp-action="Orders">Заказы</a></li>
                                <li><a class="dropdown-item" asp-controller="Manager" asp-action="Customers">Клиенты</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-danger" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                Админка
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Дашборд</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Robots">Роботы</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Пользователи</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Logs">Логи</a></li>
                            </ul>
                        </li>
                    }

                    <li class="nav-item">
                        <span class="nav-link text-light" id="nav-connection-status"></span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link text-light">@User.Identity?.Name</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning" asp-controller="Account" asp-action="Logout">Выход</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="mt-5 py-3 text-center text-muted border-top">
        <p>&copy; 2026 RoboStore</p>
    </footer>

    <!-- Connection Status Indicator -->
    <div id="connection-status" class="connection-status status-unknown" title="Проверка...">
        <span class="status-icon">?</span>
        <span class="status-text">...</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/fallbackStorage.js"></script>
    <script src="~/js/connectionStatus.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.ConnectionStatus) {
                window.ConnectionStatus.start();
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
