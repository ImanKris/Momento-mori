@model List<RoboStore.Models.User>

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-4">
        <div class="admin-header-icon" style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: rgba(0, 217, 255, 0.1); border-radius: 16px; color: var(--accent-primary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                <path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
        </div>
        <div>
            <h1 class="page-title">Пользователи</h1>
            <p class="page-subtitle">Настройка ролей и прав доступа</p>
        </div>
    </div>
</div>

<div class="admin-table-card">
    <div class="admin-table-header">
        <div class="admin-table-title">Пользователи (@(Model?.Count ?? 0))</div>
        <div class="admin-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" placeholder="Поиск..." onkeyup="searchUsers(this.value)" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Пользователь</th>
                        <th>Роль</th>
                        <th>Дата регистрации</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    @foreach (var user in Model)
                    {
                        <tr data-login="@user.Login.ToLower()">
                            <td style="font-family: monospace; color: var(--text-muted); font-size: 13px;">#@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; color: var(--bg-primary);">@user.Login[0]</div>
                                    <span style="font-weight: 600;">@user.Login</span>
                                </div>
                            </td>
                            <td>
                                <select class="status-select" data-user-id="@user.Id" onchange="updateRole(@user.Id, this.value)" style="min-width: 120px;">
                                    <option value="User" selected="@(user.Role == "User" ? "selected" : null)">User</option>
                                    <option value="Manager" selected="@(user.Role == "Manager" ? "selected" : null)">Manager</option>
                                    <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin</option>
                                </select>
                            </td>
                            <td style="color: var(--text-muted);">@user.CreatedAt.ToString("dd MMMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                </svg>
            </div>
            <h3 class="empty-state-title">Пользователей пока нет</h3>
        </div>
    }
</div>

@section Scripts {
<script>
async function updateRole(userId, newRole) {
    try {
        const response = await fetch('@Url.Action("UpdateUserRole", "Admin")', {
            method: 'POST',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ userId: userId, newRole: newRole })
        });

        const data = await response.json();

        if (data.success) {
            showToast('Роль обновлена', 'success');
        } else {
            showToast(data.message || 'Ошибка при обновлении роли', 'error');
            location.reload();
        }
    } catch (error) {
        console.error('Error:', error);
        showToast('Ошибка при обновлении роли', 'error');
        location.reload();
    }
}

function searchUsers(query) {
    const rows = document.querySelectorAll('#usersTableBody tr');
    const q = query.toLowerCase();
    rows.forEach(row => {
        if (row.dataset.login.includes(q)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>
}
