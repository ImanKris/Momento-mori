@model RoboStore.Models.Robot

@{
    ViewData["Title"] = "Добавить робота";
}

<h1 class="mb-4">Добавить робота</h1>

<div class="card">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="mb-0">@modelError.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="CreateRobot" method="post">
            <div class="mb-3">
                <label asp-for="Model" class="form-label">Модель *</label>
                <input asp-for="Model" name="Model" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="TypeId" class="form-label">Тип робота *</label>
                <select id="TypeId" name="TypeId" class="form-select" required>
                    <option value="">-- Выберите тип --</option>
                    @if (ViewBag.RobotTypes != null)
                    {
                        foreach (var type in ViewBag.RobotTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label">Серийный номер</label>
                <input asp-for="SerialNumber" name="SerialNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Цена (руб.) *</label>
                <input asp-for="Price" name="Price" class="form-control" type="number" step="0.01" min="0" required />
            </div>

            <div class="mb-3">
                <label asp-for="Stock" class="form-label">Количество на складе *</label>
                <input asp-for="Stock" name="Stock" class="form-control" type="number" min="0" required />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" name="Description" class="form-control" rows="3"></textarea>
                <small class="text-muted">Если оставить пустым, описание будет сгенерировано автоматически</small>
            </div>

            <button type="submit" class="btn btn-success">Создать</button>
            <a asp-action="Robots" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
