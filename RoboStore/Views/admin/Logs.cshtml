@model List<RoboStore.Models.Log>

@{
    ViewData["Title"] = "Системные логи";
}

<h1 class="mb-4">Системные логи</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Дата</th>
                <th>Пользователь</th>
                <th>Тип действия</th>
                <th>Детали</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.ActionDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@(log.UserLogin ?? "System")</td>
                    <td>
                        <span class="badge @GetActionBadgeClass(log.ActionType)">@log.ActionType</span>
                    </td>
                    <td>@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <h4 class="mb-3">Логов пока нет</h4>
        <p class="text-muted">Логи будут появляться при изменении статусов заказов и других действиях</p>
    </div>
}

@{
    string GetActionBadgeClass(string actionType)
    {
        return actionType switch
        {
            "LOGIN" => "bg-primary",
            "LOGOUT" => "bg-secondary",
            "ORDER_STATUS_CHANGE" => "bg-info",
            "ROBOT_CREATED" => "bg-success",
            "ROBOT_UPDATED" => "bg-warning text-dark",
            "ROBOT_DELETED" => "bg-danger",
            "USER_ROLE_CHANGED" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}
