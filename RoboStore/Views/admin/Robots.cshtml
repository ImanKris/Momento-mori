@model List<RoboStore.Models.Robot>

@{
    ViewData["Title"] = "Управление роботами";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-4">
        <div class="admin-header-icon" style="width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: rgba(0, 217, 255, 0.1); border-radius: 16px; color: var(--accent-primary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
        </div>
        <div style="flex: 1;">
            <h1 class="page-title">Роботы</h1>
            <p class="page-subtitle">Каталог и настройка товаров</p>
        </div>
        <a asp-action="CreateRobot" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Добавить робота
        </a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-error mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        @TempData["Error"]
    </div>
}

<div class="admin-table-card">
    <div class="admin-table-header">
        <div class="admin-table-title">Роботы (@(Model?.Count ?? 0))</div>
        <div class="admin-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" placeholder="Поиск..." onkeyup="searchRobots(this.value)" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Модель</th>
                        <th>Тип</th>
                        <th>Цена</th>
                        <th>На складе</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody id="robotsTableBody">
                    @foreach (var robot in Model)
                    {
                        <tr data-model="@robot.Model.ToLower()">
                            <td style="font-family: monospace; color: var(--text-muted); font-size: 13px;">#@robot.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 40px; height: 40px; background: var(--bg-tertiary); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px;">🤖</div>
                                    <span style="font-weight: 600;">@robot.Model</span>
                                </div>
                            </td>
                            <td><span class="badge badge-primary">@robot.Type</span></td>
                            <td style="font-family: 'Montserrat', sans-serif; font-weight: 700; color: var(--accent-primary);">@robot.Price.ToString("N0") ₽</td>
                            <td>
                                @if (robot.Stock > 0)
                                {
                                    <span class="badge badge-success">@robot.Stock шт.</span>
                                }
                                else
                                {
                                    <span class="badge badge-error">Нет</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditRobot" asp-route-id="@robot.Id" class="btn btn-ghost btn-sm" title="Редактировать">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                    </a>
                                    <form asp-action="DeleteRobot" asp-route-id="@robot.Id" method="post" style="display: inline;" onsubmit="return confirm('Удалить робота @robot.Model?')">
                                        <button type="submit" class="btn btn-ghost btn-sm" title="Удалить" style="color: var(--error);">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🤖</div>
            <h3 class="empty-state-title">Роботов пока нет</h3>
            <a asp-action="CreateRobot" class="btn btn-primary">Добавить первого робота</a>
        </div>
    }
</div>

<script>
function searchRobots(query) {
    const rows = document.querySelectorAll('#robotsTableBody tr');
    const q = query.toLowerCase();
    rows.forEach(row => {
        if (row.dataset.model.includes(q)) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
</script>
