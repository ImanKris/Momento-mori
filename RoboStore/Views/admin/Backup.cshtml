@{
    ViewData["Title"] = "Резервное копирование";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                <polyline points="17 21 17 13 7 13 7 21"/>
                <polyline points="7 3 7 8 15 8"/>
            </svg>
        </div>
        <div>
            <h1 class="page-title">Резервное копирование</h1>
            <p class="page-subtitle">Экспорт и восстановление данных</p>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-error mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        @TempData["Error"]
    </div>
}

@{
    var preview = TempData["RestorePreview"] != null
        ? System.Text.Json.JsonSerializer.Deserialize<RestorePreview>((string)TempData["RestorePreview"]!)
        : null;
}

@if (preview != null)
{
    <div class="preview-card mb-6">
        <div class="preview-header">
            <div class="preview-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <h2 class="preview-title">Предпросмотр восстановления</h2>
        </div>
        <div class="preview-body">
            <p class="preview-description">Будет восстановлено:</p>
            <div class="preview-stats">
                <div class="preview-stat">
                    <span class="preview-stat-value">@preview.UsersCount</span>
                    <span class="preview-stat-label">Пользователи</span>
                </div>
                <div class="preview-stat">
                    <span class="preview-stat-value">@preview.RobotsCount</span>
                    <span class="preview-stat-label">Роботы</span>
                </div>
                <div class="preview-stat">
                    <span class="preview-stat-value">@preview.OrdersCount</span>
                    <span class="preview-stat-label">Заказы</span>
                </div>
                <div class="preview-stat">
                    <span class="preview-stat-value">@preview.LogsCount</span>
                    <span class="preview-stat-label">Логи</span>
                </div>
            </div>
            <p class="preview-note">Существующие записи будут обновлены, новые — добавлены.</p>
        </div>
        <div class="preview-actions">
            <form method="post" asp-action="ConfirmRestore">
                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Подтвердить
                </button>
            </form>
            <form method="post" asp-action="CancelRestore">
                <button type="submit" class="btn btn-ghost">Отмена</button>
            </form>
        </div>
    </div>
}

<div class="backup-grid">
    <!-- Export -->
    <div class="backup-card">
        <div class="backup-card-header">
            <div class="backup-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
            </div>
            <h2 class="backup-card-title">Экспорт данных</h2>
            <p class="backup-card-description">Скачайте данные магазина для резервного копирования</p>
        </div>
        <div class="backup-card-body">
            <form method="post" asp-action="ExportJson" class="export-form">
                <button type="submit" class="btn btn-primary btn-lg w-full">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Полный JSON бэкап
                </button>
            </form>

            <div class="export-divider">
                <span>или</span>
            </div>

            <div class="export-grid">
                <form method="post" asp-action="ExportCsv">
                    <input type="hidden" name="table" value="robots" />
                    <button type="submit" class="btn btn-secondary w-full">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                        Роботы
                    </button>
                </form>
                <form method="post" asp-action="ExportCsv">
                    <input type="hidden" name="table" value="orders" />
                    <button type="submit" class="btn btn-secondary w-full">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                        </svg>
                        Заказы
                    </button>
                </form>
                <form method="post" asp-action="ExportCsv">
                    <input type="hidden" name="table" value="users" />
                    <button type="submit" class="btn btn-secondary w-full">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                        </svg>
                        Пользователи
                    </button>
                </form>
                <form method="post" asp-action="ExportCsv">
                    <input type="hidden" name="table" value="logs" />
                    <button type="submit" class="btn btn-secondary w-full">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                        Логи
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Restore -->
    <div class="backup-card">
        <div class="backup-card-header">
            <div class="backup-card-icon warning">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
            </div>
            <h2 class="backup-card-title">Восстановление</h2>
            <p class="backup-card-description">Загрузите резервную копию для восстановления данных</p>
        </div>
        <div class="backup-card-body">
            <div class="alert alert-warning mb-5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <div>
                    <strong>Внимание!</strong>
                    <ul class="alert-warning-list">
                        <li>Существующие записи обновятся</li>
                        <li>Новые записи добавятся</li>
                        <li>Удаление не происходит</li>
                    </ul>
                </div>
            </div>

            <form method="post" asp-action="RestoreJson" enctype="multipart/form-data" class="restore-form">
                <div class="form-group">
                    <label class="form-label">Выберите JSON файл</label>
                    <input type="file" name="file" class="form-control" accept=".json" required />
                </div>
                <button type="submit" class="btn btn-warning btn-lg w-full">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"/>
                        <path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
                    </svg>
                    Загрузить и проверить
                </button>
            </form>
        </div>
    </div>
</div>

<div class="back-link">
    <a asp-action="Index" class="btn btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
        </svg>
        Назад в админку
    </a>
</div>

<style>
    .page-header {
        padding: var(--space-8) 0 var(--space-10);
    }

    .page-header-content {
        display: flex;
        align-items: center;
        gap: var(--space-5);
    }

    .page-header-icon {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-cobalt-subtle);
        border-radius: var(--radius-xl);
        color: var(--accent-cobalt);
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: var(--weight-bold);
        color: var(--text-primary);
        margin: 0 0 var(--space-1);
    }

    .page-subtitle {
        font-size: 0.9375rem;
        color: var(--text-muted);
        margin: 0;
    }

    .backup-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
        margin-bottom: var(--space-8);
    }

    @@media (max-width: 768px) {
        .backup-grid {
            grid-template-columns: 1fr;
        }
    }

    .backup-card {
        background: var(--surface-1);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .backup-card-header {
        padding: var(--space-6);
        background: var(--surface-2);
        border-bottom: 1px solid var(--border-subtle);
    }

    .backup-card-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-cobalt-subtle);
        border-radius: var(--radius-lg);
        color: var(--accent-cobalt);
        margin-bottom: var(--space-4);
    }

    .backup-card-icon.warning {
        background: var(--warning-glow);
        color: var(--warning);
    }

    .backup-card-title {
        font-size: 1.125rem;
        font-weight: var(--weight-semibold);
        color: var(--text-primary);
        margin: 0 0 var(--space-2);
    }

    .backup-card-description {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin: 0;
    }

    .backup-card-body {
        padding: var(--space-6);
    }

    .export-form {
        margin-bottom: var(--space-4);
    }

    .export-divider {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin: var(--space-6) 0;
        color: var(--text-muted);
        font-size: 0.8125rem;
    }

    .export-divider::before,
    .export-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border-subtle);
    }

    .export-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
    }

    .w-full {
        width: 100%;
    }

    .alert {
        display: flex;
        gap: var(--space-3);
        padding: var(--space-4);
        border-radius: var(--radius-lg);
        font-size: 0.875rem;
    }

    .alert-success {
        background: var(--success-glow);
        border: 1px solid rgba(52, 211, 153, 0.2);
        color: var(--success);
    }

    .alert-warning {
        background: var(--warning-glow);
        border: 1px solid rgba(251, 191, 36, 0.2);
        color: var(--warning);
    }

    .alert-error {
        background: var(--error-glow);
        border: 1px solid rgba(248, 113, 113, 0.2);
        color: var(--error);
    }

    .alert svg {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .alert-warning-list {
        margin: var(--space-2) 0 0;
        padding-left: var(--space-4);
        font-size: 0.8125rem;
    }

    .alert-warning-list li {
        margin-bottom: var(--space-1);
    }

    .preview-card {
        background: var(--surface-1);
        border: 1px solid rgba(251, 191, 36, 0.3);
        border-radius: var(--radius-xl);
        overflow: hidden;
    }

    .preview-header {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-5) var(--space-6);
        background: rgba(251, 191, 36, 0.1);
        border-bottom: 1px solid rgba(251, 191, 36, 0.2);
    }

    .preview-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--warning-glow);
        border-radius: var(--radius-lg);
        color: var(--warning);
    }

    .preview-title {
        font-size: 1rem;
        font-weight: var(--weight-semibold);
        color: var(--text-primary);
        margin: 0;
    }

    .preview-body {
        padding: var(--space-6);
    }

    .preview-description {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin: 0 0 var(--space-4);
    }

    .preview-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-bottom: var(--space-4);
    }

    @@media (max-width: 480px) {
        .preview-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .preview-stat {
        text-align: center;
        padding: var(--space-4);
        background: var(--surface-2);
        border-radius: var(--radius-lg);
    }

    .preview-stat-value {
        display: block;
        font-size: 1.5rem;
        font-weight: var(--weight-bold);
        color: var(--text-primary);
    }

    .preview-stat-label {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .preview-note {
        font-size: 0.8125rem;
        color: var(--text-muted);
        margin: 0;
    }

    .preview-actions {
        display: flex;
        gap: var(--space-3);
        padding: var(--space-5) var(--space-6);
        background: var(--surface-2);
        border-top: 1px solid var(--border-subtle);
    }

    .form-group {
        margin-bottom: var(--space-5);
    }

    .form-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: var(--weight-medium);
        color: var(--text-secondary);
        margin-bottom: var(--space-2);
    }

    .form-control {
        width: 100%;
        padding: var(--space-3) var(--space-4);
        background: var(--surface-2);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        color: var(--text-primary);
        transition: all 0.2s;
    }

    .form-control:focus {
        border-color: var(--accent-cobalt);
        box-shadow: 0 0 0 3px var(--accent-cobalt-subtle);
        outline: none;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-5);
        font-size: 0.875rem;
        font-weight: var(--weight-medium);
        border-radius: var(--radius-md);
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-primary {
        background: var(--accent-cobalt);
        color: white;
    }

    .btn-primary:hover {
        background: var(--accent-cobalt-hover);
        color: white;
    }

    .btn-secondary {
        background: var(--surface-3);
        color: var(--text-primary);
        border: 1px solid var(--border-default);
    }

    .btn-secondary:hover {
        background: var(--surface-4);
        color: var(--text-primary);
    }

    .btn-warning {
        background: var(--warning);
        color: var(--base-deep);
    }

    .btn-warning:hover {
        background: #D4A506;
    }

    .btn-ghost {
        background: transparent;
        color: var(--text-secondary);
    }

    .btn-ghost:hover {
        background: var(--surface-2);
        color: var(--text-primary);
    }

    .btn-lg {
        padding: var(--space-4) var(--space-6);
    }

    .mb-5 { margin-bottom: var(--space-5); }
    .mb-6 { margin-bottom: var(--space-6); }

    .back-link {
        margin-top: var(--space-4);
    }
</style>
