@using RoboStore.Controllers
@{
    ViewData["Title"] = "Резервное копирование";
}

<h1 class="mb-4">Резервное копирование и экспорт</h1>

<!-- Messages -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Restore Preview Modal -->
@{
    var preview = TempData["RestorePreview"] != null
        ? System.Text.Json.JsonSerializer.Deserialize<RestorePreview>((string)TempData["RestorePreview"]!)
        : null;
}

@if (preview != null)
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Предпросмотр восстановления</h5>
        </div>
        <div class="card-body">
            <p>Будет восстановлено:</p>
            <ul>
                <li>Пользователи: <strong>@preview.UsersCount</strong></li>
                <li>Роботы: <strong>@preview.RobotsCount</strong></li>
                <li>Заказы: <strong>@preview.OrdersCount</strong></li>
                <li>Логи: <strong>@preview.LogsCount</strong></li>
            </ul>
            <p class="text-muted small">Существующие записи будут обновлены, новые — добавлены. Заказы и логи не удаляются.</p>
            <div class="d-flex gap-2">
                <form method="post" asp-action="ConfirmRestore">
                    <button type="submit" class="btn btn-warning">Подтвердить восстановление</button>
                </form>
                <form method="post" asp-action="CancelRestore">
                    <button type="submit" class="btn btn-secondary">Отмена</button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row">
    <!-- Export Section -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Экспорт данных</h5>
            </div>
            <div class="card-body">
                <p>Экспорт данных магазина в различных форматах.</p>

                <div class="mb-3">
                    <h6>Полный JSON бэкап</h6>
                    <p class="text-muted small">Все таблицы в одном JSON файле. Рекомендуется для полного бэкапа.</p>
                    <form method="post" asp-action="ExportJson">
                        <button type="submit" class="btn btn-primary">
                            📥 Скачать JSON бэкап
                        </button>
                    </form>
                </div>

                <hr />

                <div class="mb-3">
                    <h6>Табличные CSV экспорты</h6>
                    <p class="text-muted small">Экспорт отдельных таблиц в формате CSV.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <form method="post" asp-action="ExportCsv">
                            <input type="hidden" name="table" value="robots" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Роботы (CSV)</button>
                        </form>
                        <form method="post" asp-action="ExportCsv">
                            <input type="hidden" name="table" value="orders" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Заказы (CSV)</button>
                        </form>
                        <form method="post" asp-action="ExportCsv">
                            <input type="hidden" name="table" value="users" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Пользователи (CSV)</button>
                        </form>
                        <form method="post" asp-action="ExportCsv">
                            <input type="hidden" name="table" value="logs" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">Логи (CSV)</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Restore Section -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Восстановление из бэкапа</h5>
            </div>
            <div class="card-body">
                <p>Восстановление данных из ранее созданного JSON бэкапа.</p>

                <div class="alert alert-warning">
                    <strong>Внимание!</strong>
                    <ul class="mb-0 mt-2">
                        <li>Существующие записи будут обновлены</li>
                        <li>Новые записи будут добавлены</li>
                        <li>Заказы и логи не удаляются</li>
                        <li>Пользователи не перезаписываются</li>
                    </ul>
                </div>

                <form method="post" asp-action="RestoreJson" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Выберите JSON файл бэкапа</label>
                        <input type="file" name="file" class="form-control" accept=".json" required />
                    </div>
                    <button type="submit" class="btn btn-warning">
                        🔄 Загрузить и проверить
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Info Card -->
<div class="card bg-light">
    <div class="card-body">
        <h6>О формате бэкапа</h6>
        <p class="small mb-0">
            JSON бэкап содержит все основные данные: пользователей, роботов, типы роботов, заказы и последние 1000 логов.
            CSV экспорт позволяет выгрузить отдельные таблицы для анализа в Excel или других инструментах.
            Полный бэкап SQL Server (команда <code>BACKUP DATABASE</code>) на текущем хостинге Somee.com недоступен,
            поэтому в качестве резервного копирования используется экспорт данных в JSON.
        </p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Назад в панель администратора</a>
</div>
