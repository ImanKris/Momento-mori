@model RoboStore.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Login" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-3">
        <label class="form-label">Логин:</label>
        <input asp-for="Login" class="form-control" placeholder="Введите логин" />
        <span asp-validation-for="Login" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Пароль:</label>
        <input asp-for="Password" class="form-control" type="password" placeholder="Введите пароль" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Войти</button>
</form>
