@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-page">
    <div class="auth-card">
        <h1 class="auth-title">Регистрация</h1>
        <form id="regForm">
            <div class="form-group">
                <label class="form-label">Логин</label>
                <input type="text" id="login" class="form-control" placeholder="Придумайте логин" />
            </div>
            <div class="form-group">
                <label class="form-label">Пароль</label>
                <input type="password" id="password" class="form-control" placeholder="Минимум 4 символа" />
            </div>
            <div class="form-group">
                <label class="form-label">Подтверждение пароля</label>
                <input type="password" id="confirmPassword" class="form-control" placeholder="Повторите пароль" />
            </div>
            <button type="button" class="btn btn-primary btn-block" onclick="doRegister()">Создать аккаунт</button>
            <div id="regResult" class="mt-3 text-center"></div>
        </form>
        <div class="auth-footer">
            Уже есть аккаунт? <a href="/Account/Login">Войти</a>
        </div>
    </div>
</div>

<script>
async function doRegister() {
    const login = document.getElementById('login').value.trim();
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const result = document.getElementById('regResult');

    if (!login || !password || !confirmPassword) {
        result.innerHTML = '<span class="text-error">Заполните все поля</span>';
        return;
    }
    if (password !== confirmPassword) {
        result.innerHTML = '<span class="text-error">Пароли не совпадают</span>';
        return;
    }
    if (password.length < 4) {
        result.innerHTML = '<span class="text-error">Пароль минимум 4 символа</span>';
        return;
    }
    if (login.length < 3) {
        result.innerHTML = '<span class="text-error">Логин минимум 3 символа</span>';
        return;
    }

    result.innerHTML = '<span class="text-muted">Регистрация...</span>';

    try {
        const response = await fetch('/Account/Register', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login, password })
        });
        const data = await response.json();

        if (data.success) {
            result.innerHTML = '<span class="text-success">Регистрация успешна!</span>';
            setTimeout(() => window.location.href = '/Account/Login', 1000);
        } else {
            result.innerHTML = '<span class="text-error">' + data.message + '</span>';
        }
    } catch (e) {
        result.innerHTML = '<span class="text-error">Ошибка соединения</span>';
    }
}
</script>
