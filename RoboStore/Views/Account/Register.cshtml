@{
    ViewData["Title"] = "Регистрация в RoboStore";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Регистрация</h2>

                    <!-- Telegram Login -->
                    <div class="text-center mb-4">
                        <p class="text-muted mb-3">Быстрая регистрация через Telegram</p>
                        <script async src="https://telegram.org/js/telegram-widget.js?21" data-telegram-login="RoboStoreMoriBot" data-size="large" data-radius="10" data-auth-url="/Account/TelegramCallback" data-request-access="write"></script>
                    </div>

                    <div class="text-center mb-4">
                        <small class="text-muted">— или зарегистрируйтесь по логину —</small>
                    </div>

                    <!-- Registration Form -->
                    <div id="regForm">
                        <h5 class="mb-3">Создание аккаунта</h5>
                        <div class="mb-3">
                            <label class="form-label">Telegram username:</label>
                            <div class="input-group">
                                <span class="input-group-text">&#64;</span>
                                <input type="text" id="username" class="form-control" placeholder="your_username" />
                            </div>
                            <small class="text-muted">Напишите боту &#64;RoboStoreMoriBot в Telegram</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Логин:</label>
                            <input type="text" id="login" class="form-control" placeholder="Придумайте логин" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Пароль:</label>
                            <input type="password" id="password" class="form-control" placeholder="Минимум 4 символа" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Подтверждение пароля:</label>
                            <input type="password" id="confirmPassword" class="form-control" placeholder="Повторите пароль" />
                        </div>
                        <button type="button" class="btn btn-primary w-100" onclick="sendCode()">Получить код</button>
                        <div id="regResult" class="mt-3 text-center"></div>
                    </div>

                    <!-- Verification Form -->
                    <div id="verifyForm" style="display:none;">
                        <h5 class="mb-3">Подтверждение</h5>
                        <p class="text-muted small mb-3">Код отправлен в Telegram боту <strong>&#64;RoboStoreMoriBot</strong></p>
                        <div class="mb-3">
                            <label class="form-label">Код из Telegram:</label>
                            <input type="text" id="code" class="form-control text-center fs-4" maxlength="6" placeholder="- - - - - -" />
                        </div>
                        <button type="button" class="btn btn-success w-100" onclick="verifyCode()">Завершить регистрацию</button>
                        <button type="button" class="btn btn-link w-100 mt-2" onclick="backToReg()">Назад</button>
                        <div id="verifyResult" class="mt-3 text-center"></div>
                    </div>

                    <hr class="my-4">
                    <p class="text-center text-muted small mb-0">
                        Уже есть аккаунт? <a href="/Account/Login">Войти</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function sendCode() {
        var usernameInput = document.getElementById('username').value.trim();
        var atSymbol = String.fromCharCode(64);
        const username = usernameInput.replace(atSymbol, '');
        const login = document.getElementById('login').value.trim();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (!username || !login || !password) {
            document.getElementById('regResult').innerHTML = '<span class="text-danger">Заполните все поля</span>';
            return;
        }

        if (password !== confirmPassword) {
            document.getElementById('regResult').innerHTML = '<span class="text-danger">Пароли не совпадают</span>';
            return;
        }

        if (password.length < 4) {
            document.getElementById('regResult').innerHTML = '<span class="text-danger">Пароль должен быть не менее 4 символов</span>';
            return;
        }

        if (login.length < 3) {
            document.getElementById('regResult').innerHTML = '<span class="text-danger">Логин должен быть не менее 3 символов</span>';
            return;
        }

        document.getElementById('regResult').innerHTML = '<span class="text-muted">Отправка кода...</span>';

        const response = await fetch('/Account/RegisterSendCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, login, password })
        });

        const result = await response.json();
        const div = document.getElementById('regResult');

        if (result.success) {
            div.innerHTML = '<span class="text-success"> ' + result.message + '</span>';
            document.getElementById('regForm').style.display = 'none';
            document.getElementById('verifyForm').style.display = 'block';
            document.getElementById('code').focus();
        } else {
            div.innerHTML = '<span class="text-danger"> ' + result.message + '</span>';
        }
    }

    async function verifyCode() {
        const code = document.getElementById('code').value.trim();
        const login = document.getElementById('login').value.trim();

        if (!code || code.length !== 6) {
            document.getElementById('verifyResult').innerHTML = '<span class="text-danger">Введите 6-значный код</span>';
            return;
        }

        document.getElementById('verifyResult').innerHTML = '<span class="text-muted">Проверка...</span>';

        const response = await fetch('/Account/RegisterVerifyCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ login, code })
        });

        const result = await response.json();
        const div = document.getElementById('verifyResult');

        if (result.success) {
            div.innerHTML = '<span class="text-success"> Регистрация завершена!</span>';
            setTimeout(() => window.location.href = '/Account/Login', 1000);
        } else {
            div.innerHTML = '<span class="text-danger"> ' + result.message + '</span>';
        }
    }

    function backToReg() {
        document.getElementById('regForm').style.display = 'block';
        document.getElementById('verifyForm').style.display = 'none';
        document.getElementById('regResult').innerHTML = '';
        document.getElementById('verifyResult').innerHTML = '';
    }
</script>

<style>
    .card {
        border: none;
        border-radius: 16px;
    }
</style>
