@model RoboStore.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-info">
    <strong>Как зарегистрироваться:</strong>
    <ol class="mb-0">
        <li>Напишите боту <strong>@("@RoboStoreMoriBot")</strong> в Telegram</li>
        <li>Введите ваш <strong>Chat ID</strong> (получите от бота) и данные</li>
        <li>Нажмите "Получить код" и введите код из Telegram</li>
    </ol>
</div>

<div id="step1">
    <h4>Шаг 1: Данные</h4>
    <div class="form-group mb-3">
        <label class="form-label">Telegram Chat ID:</label>
        <input type="text" id="telegramId" class="form-control" placeholder="Например: 123456789" />
        <small class="text-muted">Напишите боту @("@RoboStoreMoriBot") чтобы получить Chat ID</small>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Логин:</label>
        <input type="text" id="login" class="form-control" placeholder="Придумайте логин (минимум 3 символа)" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Пароль:</label>
        <input type="password" id="password" class="form-control" placeholder="Минимум 6 символов" />
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Подтверждение пароля:</label>
        <input type="password" id="confirmPassword" class="form-control" placeholder="Повторите пароль" />
    </div>

    <button type="button" class="btn btn-primary" onclick="sendCode()">Получить код</button>
    <div id="sendCodeResult" class="mt-3"></div>
</div>

<div id="step2" style="display:none;">
    <h4>Шаг 2: Подтверждение</h4>
    <div class="form-group mb-3">
        <label class="form-label">Код из Telegram:</label>
        <input type="text" id="code" class="form-control" placeholder="Введите 6-значный код" maxlength="6" />
    </div>
    <button type="button" class="btn btn-success" onclick="confirmRegistration()">Завершить регистрацию</button>
    <button type="button" class="btn btn-secondary" onclick="resetForm()">Назад</button>
    <div id="confirmResult" class="mt-3"></div>
</div>

<script>
    async function sendCode() {
        const telegramId = document.getElementById('telegramId').value.trim();
        const login = document.getElementById('login').value.trim();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (!telegramId || !login || !password) {
            document.getElementById('sendCodeResult').innerHTML = '<span class="text-danger">Заполните все поля</span>';
            return;
        }

        if (password !== confirmPassword) {
            document.getElementById('sendCodeResult').innerHTML = '<span class="text-danger">Пароли не совпадают</span>';
            return;
        }

        if (password.length < 6) {
            document.getElementById('sendCodeResult').innerHTML = '<span class="text-danger">Пароль должен быть не менее 6 символов</span>';
            return;
        }

        const response = await fetch('/Account/SendCode', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ telegramId, login, password })
        });

        const result = await response.json();
        const div = document.getElementById('sendCodeResult');

        if (result.success) {
            div.innerHTML = '<span class="text-success">✅ ' + result.message + '</span>';
            document.getElementById('step1').style.display = 'none';
            document.getElementById('step2').style.display = 'block';
        } else {
            div.innerHTML = '<span class="text-danger">❌ ' + result.message + '</span>';
        }
    }

    async function confirmRegistration() {
        const code = document.getElementById('code').value.trim();

        if (!code) {
            document.getElementById('confirmResult').innerHTML = '<span class="text-danger">Введите код</span>';
            return;
        }

        const response = await fetch('/Account/ConfirmRegistration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code })
        });

        const result = await response.json();
        const div = document.getElementById('confirmResult');

        if (result.success) {
            div.innerHTML = '<span class="text-success">✅ ' + result.message + '</span>';
            setTimeout(() => window.location.href = '/', 1500);
        } else {
            div.innerHTML = '<span class="text-danger">❌ ' + result.message + '</span>';
        }
    }

    function resetForm() {
        document.getElementById('step1').style.display = 'block';
        document.getElementById('step2').style.display = 'none';
        document.getElementById('sendCodeResult').innerHTML = '';
        document.getElementById('confirmResult').innerHTML = '';
    }
</script>
