@{
    ViewData["Title"] = "Подтверждение кода";
}

<h2>@ViewData["Title"]</h2>

<p>Введите код, отправленный на вашу почту/телефон:</p>

<form asp-action="ConfirmRegistration" method="post">
    <div class="form-group mb-3">
        <label class="form-label">Код:</label>
        <input name="code" class="form-control" placeholder="Введите 6-значный код" maxlength="6" required />
    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <button type="submit" class="btn btn-primary">Подтвердить</button>
</form>
